{
  "name": "minimal-download-manager",
  "productName": "Minimal Download Manager",
  "version": "2.1.0",
  "private": true,
  "description": "Minimal Download Manager: a download manager for Windows modelled on Internet Download Manager",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\"",
    "test:e2e": "node test-e2e/run.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-static": "^0.545.0"
  },
  "author": "Minimal Download Manager",
  "build": {
    "appId": "com.miniidm.app",
    "productName": "Minimal Download Manager",
    "copyright": "Minimal Download Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "engine/**",
      "renderer/**",
      "locales/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "protocols": [
      {
        "name": "Minimal Download Manager",
        "schemes": [
          "miniidm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Minimal-Download-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minimal Download Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "pt_BR"
      ],
      "multiLanguageInstaller": true
    },
    "publish": null
  }
}
