{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal Download Manager",
  "version": "3.0.0",
  "identifier": "com.minimaldm.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Minimal Download Manager",
    "copyright": "Minimal Download Manager",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../extension": "extension",
      "icons/tray.png": "tray.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": true
      }
    }
  }
}
