{
  "manifest_version": 3,
  "name": "Minimal Download Manager",
  "version": "2.2.2",
  "description": "Connects your browser to the Minimal Download Manager program: downloads, link clicks and videos go to it.",
  "key": "",
  "minimum_chrome_version": "119",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "webRequest",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minimal Download Manager",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
